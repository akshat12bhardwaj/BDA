# Raw source data: kept locally and never committed (read-only, Decision Log D-01)
Dataset/

# Large generated tables; rebuild them with the phase pipelines (Code/*/pipeline.py)
Processed_Data/**/*.parquet

# Python and pytest caches
__pycache__/
*.py[cod]
.pytest_cache/

# Local environments and notebook checkpoints
.venv/
venv/
.ipynb_checkpoints/

# Course handout: contains the faculty member's contact details; kept locally, never published
/BDA_CSE 3712_ProjectBased.pdf

# React frontend: dependencies live outside OneDrive (node_modules is a junction); build output is generated
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# Third-party design reference frames (Navexa WMS video): local study material, not ours to publish
Documentation/Reference/

# Candidate replacement sources: raw samples kept locally, never committed (Documentation/Data_Source_Review.md)
Dataset_Candidates/

# Local secrets (e.g. .secrets/datagov_api_key): never committed
.secrets/

